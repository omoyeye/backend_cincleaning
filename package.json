{
  "name": "cin-cleaning-backend",
  "private": true,
  "version": "1.0.0",
  "description": "CiN Cleaning API (Express + MySQL), deployed on DirectAdmin with CloudLinux Passenger.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "package": "node scripts/package-deploy.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed.ts",
    "db:extract:cin": "node scripts/extract-cin-seed-sql.mjs",
    "test:pricing": "tsx scripts/test-pricing.ts",
    "check:schema": "tsx scripts/check-schema.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@getbrevo/brevo": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.16.3",
    "stripe": "^22.6.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.10",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
