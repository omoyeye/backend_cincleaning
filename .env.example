# CiN Cleaning API. Copy to `.env` in the app root on the server (never commit `.env`).

# --- Core -------------------------------------------------------------------
NODE_ENV=production
# Passenger assigns the port itself on DirectAdmin; PORT is only used locally.
PORT=3002
# Required behind Apache/Passenger so secure cookies and client IPs work.
TRUST_PROXY=1
# Booking reminders, set-off prompts and coverage warnings use local UK time.
TZ=Europe/London

# MySQL connection string. On the DirectAdmin server the host is usually localhost.
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/DBNAME

# Minimum 32 random characters.
JWT_SECRET=

# --- Website (frontend on Vercel) ---------------------------------------------
# Public website origin. Used for links in emails (/my-account, /staff, /reset-password),
# the sitemap and robots.txt, and as the default CORS allow-list.
PUBLIC_SITE_URL=https://cleanitneatly.com
# Optional: comma-separated browser origins allowed to call the API with cookies.
# Defaults to PUBLIC_SITE_URL and its www variant.
# CORS_ORIGIN=https://cleanitneatly.com,https://www.cleanitneatly.com
# Optional: Vercel Deploy Hook URL. When admin saves SEO settings or website content,
# the API asks Vercel to rebuild so pre-rendered pages pick up the change.
# VERCEL_DEPLOY_HOOK_URL=

# Session cookie. Defaults are right for https://cleanitneatly.com + https://api.cleanitneatly.com.
# COOKIE_SECURE=1
# COOKIE_SAME_SITE=lax

# --- Email and SMS (Brevo) -----------------------------------------------------
BREVO_API_KEY=
# BREVO_SENDER_NAME=CiN Cleaning
# BREVO_SENDER_EMAIL=
# BREVO_SMS_SENDER=CiNClean
# Optional SMTP fallback
# BREVO_SMTP_HOST=
# BREVO_SMTP_PORT=
# BREVO_SMTP_USER=
# BREVO_SMTP_PASSWORD=

# Inboxes (fallbacks used if unset)
# ADMIN_BOOKING_EMAIL=
# STAFF_INVOICE_EMAIL=
# SUPPORT_EMAIL=
# CONTACT_INBOX=

# --- Payments (Stripe) ---------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook endpoint: https://api.cleanitneatly.com/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=

# --- Other integrations --------------------------------------------------------
# Served to the browser via /api/maps/key, so restrict it to your domains in Google Cloud.
GOOGLE_MAPS_API_KEY=
ANTHROPIC_API_KEY=

# Password for the admin account created by `npm run db:seed`.
SEED_ADMIN_PASSWORD=
